apiVersion: nais.io/v1alpha1
kind: Application
metadata:
  name: nais-deploy-canary
  namespace: nais-verification
spec:
  env:
    - name: DEPLOY_START
      value: "{{ .DeployStart }}"
  image: europe-north1-docker.pkg.dev/nais-io/nais/images/testapp:2026-10-26-123723-11c6fae
  liveness:
    path: /ping
  port: 8080
  readiness:
    path: /ping
  replicas:
    max: 1
    min: 1
  resources:
    limits:
      cpu: 250m
      memory: 256Mi
    requests:
      cpu: 100m
      memory: 128Mi
  prometheus:
    enabled: true
    path: /metrics
  skipCaBundle: true
