apiVersion: nais.io/v1alpha1
kind: Application
metadata:
  name: nais-deploy-canary
  namespace: nais-verification
spec:
  env:
    - name: DEPLOY_START
      value: "{{ .DeployStart }}"
  image: {{ .Image }}
  command:
    - /app/canary
    - run
  port: 8080
  liveness:
    path: /
  readiness:
    path: /
  replicas:
    max: 1
    min: 1
  resources:
    limits:
      cpu: 250m
      memory: 256Mi
    requests:
      cpu: 100m
      memory: 128Mi
  prometheus:
    enabled: true
    path: /metrics
  skipCaBundle: true
